<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_stock_health"
            model="ir.ui.view">

        <field name="name">
            product.template.form.stock.health
        </field>

        <field name="model">product.template</field>

        <field name="inherit_id"
               ref="product.product_template_only_form_view"/>

        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Stock Health" name="stock_health_page">
                    <group>
                        <group string="Inventory Monitoring">
                            <field name="is_storable" invisible="1"/>

                            <field name="stock_min_threshold"
                                string="Minimum Stock Threshold"
                                invisible="not is_storable"/>

                            <field name="qty_available"
                                string="On Hand Quantity"
                                readonly="1"
                                invisible="not is_storable"/>

                            <field name="stock_health_status"
                                string="Stock Health"
                                widget="badge"
                                readonly="1"
                                decoration-success="stock_health_status == 'ok'"
                                decoration-warning="stock_health_status == 'low'"
                                decoration-danger="stock_health_status == 'out'"
                                invisible="not is_storable"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>